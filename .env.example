# Copy this file to ".env" and fill in your real secrets.
# The .env file is git-ignored and must NEVER be committed.

# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=123456:your-telegram-bot-token-here

# Anthropic API key from https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key-here

# Optional: default model used for new chats.
# One of: claude-opus-4-8 | claude-sonnet-4-6 | claude-haiku-4-5
DEFAULT_MODEL=claude-opus-4-8

# Optional: comma-separated list of Telegram user IDs allowed to use the bot.
# Leave empty to allow everyone.
ALLOWED_USER_IDS=

# Comma-separated Telegram user IDs with admin rights (/grant, /revoke).
ADMIN_USER_IDS=

# Subscription settings (paid via Telegram Stars — no card/provider needed).
SUBSCRIPTION_PRICE_STARS=150
SUBSCRIPTION_DAYS=30
